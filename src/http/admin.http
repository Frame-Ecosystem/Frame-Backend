###
# Admin API requests (VS Code REST Client)
# Install "REST Client" extension and click "Send Request".

@api = http://0.0.0.0:2000
@admin = {{api}}/v1/admin
@accessToken = REPLACE_WITH_ADMIN_JWT
@csrfToken = dev-bypass
@userId = 507f1f77bcf86cd799439011

###
# List users (paginated)
GET {{admin}}/users?page=1&limit=20&search=
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Get one user
GET {{admin}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Create user
POST {{admin}}/users
Authorization: Bearer {{accessToken}}
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{
    "email": "admin.created.user@example.com",
    "password": "StrongP@ssword1",
    "phoneNumber": "12345678",
    "firstName": "Admin",
    "lastName": "Created",
    "type": "client"
}

###
# Update user
PUT {{admin}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{
    "firstName": "Updated",
    "lastName": "User"
}

###
# Toggle block state
PATCH {{admin}}/users/{{userId}}/block
Authorization: Bearer {{accessToken}}
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{
    "isBlocked": true
}

###
# Delete user
DELETE {{admin}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

###
# Session info
GET {{admin}}/session-info
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Lounge names
GET {{admin}}/lounges/names
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Admin stats
GET {{admin}}/system/stats
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# System health
GET {{admin}}/system/health
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Activity log
GET {{admin}}/system/activity-log?limit=50
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Dashboard
GET {{admin}}/system/dashboard
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Clear user sessions
POST {{admin}}/system/users/{{userId}}/clear-sessions
Authorization: Bearer {{accessToken}}
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

###
# Reset user password
POST {{admin}}/system/users/{{userId}}/reset-password
Authorization: Bearer {{accessToken}}
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{
    "newPassword": "NewStrongP@ssword2"
}

###
# Export user data
GET {{admin}}/system/users/{{userId}}/export
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###
# Create admin audit log
POST {{admin}}/system/audit-log
Authorization: Bearer {{accessToken}}
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{
    "action": "ADMIN_USER_FORCE_LOGOUT",
    "details": {
        "targetUserId": "{{userId}}",
        "reason": "Security review"
    }
}

