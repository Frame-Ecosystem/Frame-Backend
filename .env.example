NODE_ENV=development
PORT=2000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/frame_beauty_dev

# Auth
SECRET_KEY=replace-with-local-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-different-local-refresh-token-secret
REFRESH_TOKEN_COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_SAMESITE=auto
REFRESH_TOKEN_COOKIE_SECURE=auto

# Logging
LOG_FORMAT=dev
LOG_DIR=./logs
ENABLE_MONGOOSE_DEBUG=false

# CORS
CREDENTIALS=true
# Local URLs set to 0.0.0.0 are rewritten to http://<LAN_IP>:<port> by config.
LOCAL_FRONTEND_PORT=2111
LOCAL_BACKEND_PORT=2000
LOCAL_FRONTEND_BASE_URL=
LOCAL_BACKEND_BASE_URL=
FRONTEND_BASE_URL=http://0.0.0.0:2111
BACKEND_BASE_URL=http://0.0.0.0:2000
MAGIC_LINK_BASE_URL=http://0.0.0.0:2111
ORIGIN=http://0.0.0.0:2111

# Admin bootstrap
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudflare R2 (required only if ENABLE_IMAGE_UPLOAD=true)
ENABLE_IMAGE_UPLOAD=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Firebase (optional)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
